# ==============================================================================
# RouteXAI — Environment Configuration Template
# Copy this file to backend/.env and provide your specific credentials before running.
# Never commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server Network Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB instance)
# Format: mongodb://localhost:27017/routexai OR mongodb+srv://<username>:<password>@cluster.mongodb.net/routexai
MONGO_URI=mongodb://127.0.0.1:27017/routexai

# JSON Web Token Secret for Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# OpenRouteService API Key (Sign up at https://openrouteservice.org/ to obtain free API key)
# Used for real road network routing, waypoint geometry, and distance calculation across India
ORS_API_KEY=your_openrouteservice_api_key_here

# Python FastAPI Machine Learning Microservice Endpoints (Port 8000)
FASTAPI_ETA_URL=http://127.0.0.1:8000/predict/eta
FASTAPI_RISK_URL=http://127.0.0.1:8000/predict/risk
